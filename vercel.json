{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "audit-service": {
      "root": "backend/audit-service",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "runtime": "node"
    }
  },
  "rewrites": [
    {
      "source": "/audit/(.*)",
      "destination": {
        "service": "audit-service"
      }
    },
    {
      "source": "/audit",
      "destination": {
        "service": "audit-service"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
