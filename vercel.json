{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/env.js",
      "destination": "/api/env"
    },
    {
      "source": "/config.js",
      "destination": "/api/env"
    },
    {
      "source": "/audit/(.*)",
      "destination": "/api/audit"
    },
    {
      "source": "/audit",
      "destination": "/api/audit"
    },
    {
      "source": "/api/audit/(.*)",
      "destination": "/api/audit"
    },
    {
      "source": "/api/audit",
      "destination": "/api/audit"
    },
    {
      "source": "/frontend/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
