# ==========================================================
# Leave Management System - Global Environment Example (.env.example)
# ==========================================================

# ----------------- Frontend Service -----------------
NODE_ENV=production
BACKEND_URL=http://localhost:8080/api

# ----------------- Audit Microservice -----------------
AUDIT_PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=leave_audit

# ----------------- Spring Boot Primary Backend -----------------
SPRING_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/leave_management?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
AUDIT_SERVICE_URL=http://localhost:5000/log
