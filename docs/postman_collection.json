    {
      "name": "2. Employee Leave Operations",
      "item": [
        {
          "name": "2.1 Submit Leave Request (Success 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"CASUAL\",\n  \"fromDate\": \"2026-11-01\",\n  \"toDate\": \"2026-11-03\",\n  \"reason\": \"Family wedding ceremony\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leaves",
              "host": ["{{baseUrl}}"],
              "path": ["leaves"]
            }
          }
        },
        {
          "name": "2.2 Submit Leave ToDate Earlier Than FromDate (400 Negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"CASUAL\",\n  \"fromDate\": \"2026-11-05\",\n  \"toDate\": \"2026-11-01\",\n  \"reason\": \"Invalid date range test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leaves",
              "host": ["{{baseUrl}}"],
              "path": ["leaves"]
            }
          }
        },
        {
          "name": "2.3 Submit Leave Missing Reason (400 Negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"SICK\",\n  \"fromDate\": \"2026-11-01\",\n  \"toDate\": \"2026-11-02\",\n  \"reason\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leaves",
              "host": ["{{baseUrl}}"],
              "path": ["leaves"]
            }
          }
        },
        {
          "name": "2.4 Get My Leaves History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves/my",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "my"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Leave Management",
      "item": [
        {
          "name": "3.1 Get All Leave Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves",
              "host": ["{{baseUrl}}"],
              "path": ["leaves"]
            }
          }
        },
        {
          "name": "3.2 Filter Leaves By Status (PENDING)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["leaves"],
              "query": [
                { "key": "status", "value": "PENDING" }
              ]
            }
          }
        },
        {
          "name": "3.3 Get Single Leave Details (ID: 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves/1",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "1"]
            }
          }
        },
        {
          "name": "3.4 Approve Pending Leave Request",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "1", "approve"]
            }
          }
        },
        {
          "name": "3.5 Approve Already Decided Leave (409 Conflict Negative)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "1", "approve"]
            }
          }
        },
        {
          "name": "3.6 Reject Pending Leave Request",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leaves/2/reject",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "2", "reject"]
            }
          }
        }
      ]
    },
